GEMINI_API_KEY="PEGA_AQUI_TU_CLAVE_DE_GOOGLE_AI_STUDIO"

# Modelo de Gemini a utilizar (opcional, por defecto gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"
